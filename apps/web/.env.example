# Browser network selection is explicit; no implicit mainnet/testnet fallback.
NEXT_PUBLIC_WAYBILL_NETWORK=testnet
NEXT_PUBLIC_WAYBILL_API_BASE_URL=http://localhost:3001

# Public Privy app configuration. Never put authorization keys or private keys here.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Mainnet addresses come from ARC_MAINNET in packages/network/src/networks.ts, never from here. RPC_URL may be
# set (for example /rpc, the same-origin proxy); every other value below is optional and must repeat the
# checked-in one, or the app refuses to load. NEXT_PUBLIC_WAYBILL_LOCAL_FORK=1 (local anvil fork only) lets
# these supply the whole manifest while none is checked in.
NEXT_PUBLIC_WAYBILL_LOCAL_FORK=
NEXT_PUBLIC_WAYBILL_MAINNET_CHAIN_ID=
NEXT_PUBLIC_WAYBILL_MAINNET_RPC_URL=
NEXT_PUBLIC_WAYBILL_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_WAYBILL_MAINNET_USDC_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_ESCROW_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_ARBITER_LIST_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_ATTESTOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_BOND_VAULT_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_FINANCING_VAULT_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_MULTICALL3_ADDRESS=
NEXT_PUBLIC_WAYBILL_MAINNET_EARLY_RESOLVE=

# Optional, server-side. The public address of this site (https://...), used for absolute link-preview URLs.
WAYBILL_SITE_URL=
