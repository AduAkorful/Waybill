# Browser network selection is explicit; no implicit mainnet/testnet fallback.
VITE_WAYBILL_NETWORK=testnet
VITE_WAYBILL_API_BASE_URL=http://localhost:3000

# Public Privy app configuration. Never put authorization keys or private keys here.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Required only when VITE_WAYBILL_NETWORK=mainnet. Leave unset until a reviewed
# mainnet deployment exists.
VITE_WAYBILL_MAINNET_CHAIN_ID=
VITE_WAYBILL_MAINNET_RPC_URL=
VITE_WAYBILL_MAINNET_EXPLORER_URL=
VITE_WAYBILL_MAINNET_USDC_ADDRESS=
VITE_WAYBILL_MAINNET_ESCROW_ADDRESS=
VITE_WAYBILL_MAINNET_ARBITER_LIST_ADDRESS=
VITE_WAYBILL_MAINNET_ATTESTOR_REGISTRY_ADDRESS=
VITE_WAYBILL_MAINNET_BOND_VAULT_ADDRESS=
VITE_WAYBILL_MAINNET_FINANCING_VAULT_ADDRESS=
