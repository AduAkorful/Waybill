{
  "name": "waybill",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/relayer",
    "packages/network",
    "contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @waybill/web",
    "build:web": "npm run build -w @waybill/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:web": "npm run test -w @waybill/web",
    "test:relayer": "npm run test -w @waybill/relayer",
    "test:network": "npm run test -w @waybill/network",
    "dev:prototype": "npm --prefix apps/prototype run dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "viem": "2.57.7"
  }
}
